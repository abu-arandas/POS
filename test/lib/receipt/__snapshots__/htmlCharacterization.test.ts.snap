exports[`kitchen ticket markup > renders items in large type with no pricing 1`] = `
"
    <div class="receipt">
      <div class="center bold kitchen-title">*** GRILL ***</div>
      
      <div class="center">Cafe Test</div>
      <div class="divider"></div>

      <div class="flex-row"><span>RECEIPT / ORDER NO.:</span><span class="bold ltr">TX-ABCD1234</span></div>
      
      <div class="flex-row"><span>TIME:</span><span class="ltr">20:15</span></div>
      <div class="flex-row"><span>OPERATOR:</span><span>Ada Lovelace</span></div>
      <div class="flex-row"><span>Customer</span><span>Grace Hopper</span></div>

      <div class="divider"></div>

      <div class="kitchen-item">2x Latte</div><div class="kitchen-item">1x Croissant</div>

      <div class="divider"></div>
      <div class="center bold">3 ITEMS</div>
      
    </div>"
`;
