      <div class="center muted">Downtown</div>
      <div class="center muted">1 Test Street</div>
      <div class="center muted">هاتف: 555-0100</div>
      <div class="center muted">الرقم الضريبي: VAT-99</div>
      <div class="divider"></div>

      <div class="flex-row"><span>التاريخ:</span><span class="ltr">2026-03-04</span></div>
      <div class="flex-row"><span>الوقت:</span><span class="ltr">8:15 PM</span></div>
      <div class="flex-row"><span>الإيصال:</span><span class="bold ltr">TX-ABCD1234</span></div>
      <div class="flex-row"><span>الموظف:</span><span>Ada Lovelace</span></div>
      <div class="flex-row bold"><span>العضو:</span><span>Grace Hopper</span></div>

      <div class="divider"></div>

      
        <div class="flex-row">
          <span>2x Latte</span>
          <span class="ltr">$9.00</span>
        </div><div class="flex-row muted item-unit"><span>@ $4.50 للوحدة</span><span></span></div>
        <div class="flex-row">
