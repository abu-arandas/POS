exports[`customer receipt markup > collapses the blocks its toggles switch off 1`] = `
"
    <div class="receipt">
      <div class="center bold receipt-header">CUSTOMER COPY</div>
      
      <div class="center bold store-name">Cafe Test</div>
      
      <div class="center muted">1 Test Street</div>
      <div class="center muted">Phone: 555-0100</div>
      
      <div class="divider"></div>

      <div class="flex-row"><span>DATE:</span><span class="ltr">2026-03-04</span></div>
      <div class="flex-row"><span>TIME:</span><span class="ltr">8:15 PM</span></div>
      <div class="flex-row"><span>RECEIPT:</span><span class="bold ltr">TX-ABCD1234</span></div>
      
      

      <div class="divider"></div>

      
        <div class="flex-row">
          <span>2x Latte</span>
          <span class="ltr">$9.00</span>
        </div>
        <div class="flex-row">
          <span>1x Croissant</span>
          <span class="ltr">$3.00</span>
        </div>

      <div class="divider"></div>

      
      <div class="flex-row muted"><span>ITEMS:</span><span class="ltr">3</span></div>
      <div class="flex-row"><span>SUBTOTAL:</span><span class="ltr">$12.00</span></div>
      <div class="flex-row"><span>DISCOUNT:</span><span class="ltr">-$2.00</span></div>
      <div class="flex-row"><span>TAX (8.5%):</span><span class="ltr">$0.85</span></div>
      <div class="flex-row text-lg total-row"><span>TOTAL PAID:</span><span class="ltr">$10.85</span></div>
      <div class="center bold savings">YOU SAVED $2.00</div>

      <div class="divider"></div>

      <div class="flex-row"><span>PAY METHOD:</span><span class="bold">Cash</span></div>
      <div class="flex-row"><span>&nbsp;&nbsp;Card</span><span class="ltr">$5.00</span></div><div class="flex-row"><span>&nbsp;&nbsp;Cash</span><span class="ltr">$10.00</span></div>
      
      <div class="flex-row"><span>CASH PAID:</span><span class="ltr">$10.00</span></div>
      <div class="flex-row bold"><span>CASH CHANGE:</span><span class="ltr">$4.15</span></div>
      

      <div class="divider"></div>

      <div class="center bold uppercase status-line status-partial">Partially Refunded</div>
      <div class="center">Refund 2026-03-05</div>
      <div class="center">REFUND AUTH: Jane (manager)</div>

      <div class="divider"></div>

      <div class="center footer-msg">Thank you for visiting!</div>
      
    </div>"
`;

exports[`customer receipt markup > keeps numeric values LTR-isolated on an Arabic receipt 1`] = `
"
    <div class="receipt">
      <div class="center bold receipt-header">CUSTOMER COPY</div>
      <div class="logo"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 512 512"><g fill="none" stroke="#000" stroke-width="48" stroke-linecap="round" stroke-linejoin="round"><path d="M148 402 L256 148"/><path d="M256 148 L364 402"/><path d="M205 352 L307 352"/></g><path d="M96 322 C 150 232, 262 190, 356 214" fill="none" stroke="#000" stroke-width="28" stroke-linecap="round"/><path d="M330 168 L410 206 L344 258 Z" fill="#000"/><path d="M398 62 L411 104 L453 117 L411 130 L398 172 L385 130 L343 117 L385 104 Z" fill="#000"/></svg></div>
