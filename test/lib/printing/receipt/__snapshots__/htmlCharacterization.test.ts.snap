exports[`kitchen ticket markup > renders items in large type with no pricing 1`] = `
"
    <div class="receipt">
      <div class="center kitchen-title">*** GRILL ***</div>
      
      <div class="center store-meta">Cafe Test</div>
      <div class="divider"></div>

      <div class="flex-row bold"><span>RECEIPT / ORDER NO.:</span><span class="num ltr">TX-ABCD1234</span></div>
      
      <div class="flex-row"><span>TIME:</span><span class="num ltr">20:15</span></div>
      <div class="flex-row"><span>OPERATOR:</span><span class="num ltr">Ada Lovelace</span></div>
      <div class="flex-row"><span>Customer</span><span class="num ltr">Grace Hopper</span></div>

      <div class="divider"></div>

      <div class="kitchen-item">2x Latte</div><div class="kitchen-item">1x Croissant</div>

      <div class="divider"></div>
      <div class="center kitchen-count">3 ITEMS</div>
      
    </div>"
`;
