# Supabase credentials used by the seed script (src/db/seed.mjs).
# Create a project at https://supabase.com, then copy its Project URL and keys
# from Project Settings → API.
#
# Copy this file to .env and fill in your own values. Never commit real keys.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Preferred for seeding: the service_role key bypasses Row Level Security
# (which the default schema enables). SERVER-SIDE ONLY — never ship it in the
# app or expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Fallback: the public anon key. Seeding with it only works if you disabled
# RLS (throwaway demos only).
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Device account used by scripts/upload_to_supabase.mjs, which signs in as a
# terminal (anon alone cannot write once RLS is on). These are credentials, not
# configuration: keep them in .env, never in a source file.
SUPABASE_DEVICE_EMAIL="device@example.com"
SUPABASE_DEVICE_PASSWORD="YOUR_DEVICE_ACCOUNT_PASSWORD"

# The store these rows belong to, on a database that has run
# src/db/multi-store-schema.sql. Required there: multi-store-rls-enforce.sql
# declares store_id NOT NULL, and a write without it either fails outright or
# lands rows no scoped pull can ever see. Leave empty for a single-store
# database, which has no store dimension.
SUPABASE_STORE_ID=""

# Optional: the device-backup export that scripts/upload_to_supabase.mjs
# imports. The script also takes it as its first argument. Point this at your
# own export — a backup is a store's live catalogue, costs and margins
# included, so it belongs outside the repository.
POS_BACKUP_FILE=""
