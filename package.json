{
  "name": "ea-pos",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "description": "EA POS — offline-first point-of-sale for retail and café: inventory, checkout, QR digital menu server, and network thermal-printer support.",
  "author": {
    "name": "abu-arandas",
    "email": "e00arandas@gmail.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "perf:check": "node src/build/check-bundle-budget.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,mjs}\" \"electron/*.{cjs,mjs}\" \"scripts/*.mjs\" \".github/**/*.yml\" \"*.{ts,js,cjs,json,md}\"",
    "portable": "vite build --config vite.portable.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,mjs}\" \"electron/*.{cjs,mjs}\" \"scripts/*.mjs\" \".github/**/*.yml\" \"*.{ts,js,cjs,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.110.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "i18next": "^26.3.6",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.31.0",
    "motion": "^12.23.24",
    "prettier": "^3.9.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^17.0.9",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "http-cache-semantics": "4.2.0",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2"
  }
}
